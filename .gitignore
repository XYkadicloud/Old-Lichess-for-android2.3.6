# =============================================================================
# Lichess Old — .gitignore
#
# 排除原则：
#   1. 能重新下载的依赖不进仓库（toolchain/ 584MB，由 scripts/setup.sh 拉取）
#   2. 编译中间产物不进仓库（build/ 342MB）
#   3. 交付物（APK / JAR）走 GitHub Release，不进仓库历史
#   4. 运行期数据、日志、崩溃转储不进仓库
# =============================================================================

# ---------------------------------------------------------------------------
# 工具链（scripts/setup.sh 会重新下载，本地约 584MB）
#   toolchain/jdk8/               JDK8
#   toolchain/android-build-tools/ d8 / dx / apksigner
#   toolchain/downloads/          下载的压缩包缓存
#   toolchain/libs/               android-2.3.3.jar / sc-core-1.58.0.0.jar
# ---------------------------------------------------------------------------
toolchain/

# app/libs 里那份 sc-core 是从 toolchain/libs 复制来的，同一份东西不重复入库
app/libs/*.jar

# ---------------------------------------------------------------------------
# 编译中间产物
# ---------------------------------------------------------------------------
build/
desktop/build/
desktop/build/*/

# ---------------------------------------------------------------------------
# 交付物：走 Release 附件，不进仓库历史
#   dist/*.apk                    Android 安装包
#   desktop/dist/*.jar            桌面版可执行 JAR
# ---------------------------------------------------------------------------
dist/*.apk
desktop/dist/*.jar

# 桌面版的构建信息文本（构建脚本每次重新生成，属于产物）
desktop/dist/*.deps.txt

# 桌面版运行期数据（设置 / 日志 / 诊断结果）
desktop/dist/data/

# ---------------------------------------------------------------------------
# 运行期与诊断产物
# ---------------------------------------------------------------------------
logs/
*.log
hs_err_pid*.log
replay_pid*.log

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*~
.DS_Store
Thumbs.db
desktop-null/

# ---------------------------------------------------------------------------
# 注意：keystore/lichessold.jks **故意不排除**。
#   项目 README 里写明它是自用签名密钥，口令是公开的固定值，
#   作用只是保证升级时签名一致，不是安全边界（真正的安全边界是 API 令牌，
#   它只存在用户本机，永不入库）。
# =============================================================================
