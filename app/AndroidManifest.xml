<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lichessold"
    android:versionCode="__VERSION_CODE__"
    android:versionName="__VERSION_NAME__">

    <!-- Android 2.3.6 / API 10。targetSdk 锁在 10，禁用新系统上的兼容行为变更。 -->
    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar"
        android:allowBackup="false">

        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.GamesActivity"
            android:label="@string/title_games"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.GameActivity"
            android:label="@string/title_game"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.PuzzleActivity"
            android:label="@string/title_puzzle"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.AiGameActivity"
            android:label="@string/title_ai"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.LocalGameActivity"
            android:label="@string/title_local"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.TvActivity"
            android:label="@string/title_tv"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.TournamentsActivity"
            android:label="@string/title_tournaments"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.TournamentActivity"
            android:label="@string/title_tournament"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.ActivityActivity"
            android:label="@string/title_activity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.PgnActivity"
            android:label="@string/title_pgn"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.ProfileActivity"
            android:label="@string/title_profile"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.DiagActivity"
            android:label="@string/title_diag"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".ui.LogActivity"
            android:label="@string/title_log"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden" />

    </application>
</manifest>
